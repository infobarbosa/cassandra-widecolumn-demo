   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "O token diz qual faixa; o fator de replicação diz quantas cópias.\nO dono da faixa e os nós seguintes no ring guardam as réplicas.\nQualquer nó pode ser o coordinator. Faixas simplificadas, como na figura anterior.",
   "originalText": "O token diz qual faixa; o fator de replicação diz quantas cópias.\nO dono da faixa e os nós seguintes no ring guardam as réplicas.\nQualquer nó pode ser o coordinator. Faixas simplificadas, como na figura anterior.",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
